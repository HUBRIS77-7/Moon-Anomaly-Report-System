		"accessible": true,
		"exclusive_to_week": "",
	},
	{
		"id": 79,
		"name": "Suspicious Vehicle",
		"category": Category.SECURITY,
		"severity": 2,
		"danger": 1,
		"scale": 1,
		"type": Category.SECURITY,
		"description": "Suspicious Vehicles are vehicles, both actual vehicles and space-faring ships, designated by Security Personnel as suspicious, out of place, or more commonly, abandoned in strange places. However, due to the number of vehicles that end up abandoned, non-Security personnel also report Suspicious Vehicles. \n \n It is advised that non-Security personnel do not approach Suspicious Vehicles. Additionally, if it is noted that the Suspicious Vehicle in question is located near a Unmaintained Station, Unmarked Lava Tunnel, or any sort of cave, please file as a Lost Cause (#56) instead. ",
		"icon_path": " ",
